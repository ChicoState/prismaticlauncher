/* Palette: light surfaces and amber accents, following the newer launcherWindow UI.
   Spacing follows an 8px scale; controls use 6px corners and panels use 8px. */
QWidget { background: #f1f2f3; color: #30363b; font-size: 14px; }
QWidget#header { background: #ffffff; border-bottom: 1px solid #dadddf; }
QLabel { background: transparent; }
QLabel#brandMark { color: #ffb703; font-size: 32px; }
QLabel#brand { font-size: 18px; font-weight: 700; letter-spacing: 3px; }
QLabel#heading { font-size: 32px; font-weight: 700; }
QLabel#sectionTitle { font-size: 22px; font-weight: 600; }
QLabel#eyebrow { color: #616a70; font-size: 11px; font-weight: 600; letter-spacing: 2px; }
QLabel#muted { color: #626c73; font-size: 13px; }
QLabel#emptyIcon { color: #ffb703; font-size: 64px; }
QLabel#emptyTitle { font-size: 18px; font-weight: 600; }
QPushButton { background: #ffffff; border: 1px solid #ccd1d4; border-radius: 6px;
              padding: 10px 16px; font-weight: 600; }
QPushButton:hover { background: #f8f9fa; border-color: #a38b4d; }
QPushButton:pressed { background: #e7e9eb; }
QPushButton:focus, QLineEdit:focus, QComboBox:focus { border: 1px solid #805900; }
QPushButton#primary { background: #ffb703; color: #30250b; border-color: #ffb703; }
QPushButton#primary:hover { background: #ffd05b; }
QPushButton#primary:focus { border: 2px solid #805900; padding: 9px 15px; }
QPushButton:disabled { background: #e8ebed; color: #899197; border-color: #dadddf; }
QLineEdit, QComboBox { background: #ffffff; border: 1px solid #ccd1d4;
                     border-radius: 6px; padding: 10px; selection-background-color: #ffe8ad; }
QComboBox::drop-down { width: 24px; border: none; }
QComboBox QAbstractItemView { background: #ffffff; selection-background-color: #ffe8ad; }
QListWidget#instances { border: 1px solid #dadddf; border-radius: 8px; background: #ffffff; padding: 16px; }
QListWidget#instances::item { background: #f8f9fa; border: 1px solid #ccd1d4;
                            border-radius: 8px; padding: 8px; }
QListWidget#instances::item:selected { background: #fff4d6; border: 2px solid #ffb703; }
QListWidget#instances::item:hover { background: #f2f3f4; }
QWidget#sidebar { background: #ffffff; border: 1px solid #dadddf; border-radius: 8px; }
QListWidget#navigation { background: transparent; border: none; outline: none; }
QListWidget#navigation::item { padding: 14px 12px; border-radius: 6px; margin-bottom: 4px; }
QListWidget#navigation::item:selected { background: #ffe8ad; color: #46370f; }
QListWidget#navigation::item:hover { background: #f3f4f5; }
QListWidget#navigation::item:focus { border: 1px solid #805900; }
QStackedWidget#detailPages { border: 1px solid #dadddf; border-radius: 8px; }
QPlainTextEdit { background: #ffffff; border: 1px solid #dadddf; border-radius: 6px;
                 padding: 12px; font-family: monospace; color: #30363b; }
QStatusBar { background: #ffffff; color: #626c73; border-top: 1px solid #dadddf; font-size: 12px; }
QScrollBar:vertical { background: #ffffff; width: 10px; }
QScrollBar::handle:vertical { background: #b8c0c5; border-radius: 4px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* Name-only master list with a persistent, independently scrolling detail pane. */
QWidget#modBrowser { background: #f1f2f3; }
QListWidget#modList { background: #ffffff; border: 1px solid #dadddf;
                      border-radius: 6px; padding: 4px; outline: none; }
QListWidget#modList::item { padding: 14px 10px; border: 1px solid transparent;
                            border-radius: 4px; color: #42484d; }
QListWidget#modList::item:hover { background: #f3f4f5; }
QListWidget#modList::item:selected { background: #ffe8ad; color: #382c0c;
                                     border-color: #e4ba53; font-weight: 600; }
QListWidget#modList::item:focus { border: 1px solid #9a6b00; }
QWidget#modDetailPanel { background: #ffffff; border: 1px solid #dadddf; border-radius: 8px; }
QScrollArea#modDetailScroll, QWidget#modDetailContent { background: #ffffff; border: none; }
QLabel#modTitle { color: #30363b; font-size: 24px; font-weight: 700; }
QLabel#modAuthor { color: #5c666d; font-size: 13px; }
QLabel#modMetadata { color: #626c73; font-size: 12px; }
QLabel#modSummary { color: #42484d; font-size: 14px; }
QLabel#modDescription { color: #59636a; font-size: 13px; }
QLabel#modListStatus, QLabel#modDetailStatus { color: #626c73; font-size: 12px; }
QPushButton#modDownload { background: #ffb703; color: #30250b; border: 1px solid #dea400;
                          padding: 12px 16px; }
QPushButton#modDownload:hover { background: #ffd05b; }
QPushButton#modDownload:focus { border: 2px solid #805900; padding: 11px 15px; }
QPushButton#modDownload:disabled { background: #e8ebed; color: #899197; border-color: #dadddf; }
QSplitter#modSplitter::handle { background: #f1f2f3; }
QSplitter#modSplitter::handle:hover { background: #e0e4e7; }
