
QWidget {
    background: #f1f2f3;
    color: #3f454a;
    font-size: 14px;
}

QWidget#centralWidget {
    background: #f1f2f3;
}

QLabel {
    background: transparent;
}


QLabel#brandMark {
    color: #3e9a61;
    font-size: 28px;
}

QLabel#brand {
    color: #3f454a;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#heading {
    color: #30363b;
    font-size: 28px;
    font-weight: 700;
}

QLabel#detailTitle {
    color: #30363b;
    font-size: 20px;
    font-weight: 600;
}

QLabel#sectionTitle,
QLabel#modsTitle,
QLabel#logsTitle,
QLabel#settingsTitle,
QLabel#smapiTitle,
QLabel#modpacksTitle {
    color: #30363b;
    font-size: 21px;
    font-weight: 600;
}

QLabel#eyebrow,
QLabel#modsPreview {
    color: #747b80;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#muted,
QLabel#mutedSidebar,
QLabel#modsDescription,
QLabel#logsDescription,
QLabel#settingsDescription,
QLabel#settingsNote,
QLabel#smapiDescription,
QLabel#modpacksDescription,
QLabel#emptyDescription,
QLabel#note {
    color: #747b80;
    font-size: 13px;
}

QLabel#emptyIcon {
    color: #4b9dcc;
    font-size: 56px;
}

QLabel#emptyTitle {
    color: #42484d;
    font-size: 18px;
    font-weight: 600;
}

QPushButton {
    background: #f1f2f3;
    color: #3f454a;
    padding: 14px 14px;
    min-height: 18px;
    font-weight: 400;
    outline: none;
    border: none;
}

QPushButton#settings,
QPushButton#smapi {
    padding: 8px 8px;
    max-height: 32px;
}

QPushButton#farmPackToggle:checked {
    background: #ffe8ad;
    border: 1px solid #d8a900;
    border-radius: 4px;
}

QSlider#farmPackOpacity {
    min-height: 18px;
}

QPushButton:hover {
    background: #eef1f3;
    border: 1px solid #ffb703;
    border-radius: 4px;
    border-color: #aab3b8;
}

QPushButton:pressed {
    background: #e3e7e9;
}

QPushButton:focus,
QLineEdit:focus,
QComboBox:focus,
QListWidget:focus,
QPlainTextEdit:focus {
    border: 1px solid #ffb703;
}

QPushButton#playDetailInstance:hover,
QPushButton#savePath:hover {
    background: #3d8ebd;
    border-color: #3d8ebd;
}

QPushButton#playInstance:pressed,
QPushButton#playDetailInstance:pressed,
QPushButton#savePath:pressed {
    background: #ffb703;
}

QPushButton:disabled {
    background: #e8eaeb;
    color: #9aa1a5;
    border-color: #d7dbdd;
}

QLineEdit,
QComboBox {
    background: #ffffff;
    color: #3f454a;
    border: 1px solid #cbd0d3;
    border-radius: 4px;
    padding: 8px 10px;
    selection-background-color: #ffe8ad;
    selection-color: #24343d;
}

QLineEdit::placeholder {
    color: #8d959a;
}

QComboBox {
    padding-right: 28px;
}

QComboBox::drop-down {
    width: 24px;
    border: none;
    border-left: 1px solid #e0e3e5;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    color: #3f454a;
    border: 1px solid #cbd0d3;
    selection-background-color: #dceef7;
    selection-color: #2e5f78;
}

QListWidget#instances {
    background: #ffffff;
    padding: 16px;
    qproperty-iconSize: 72px 72px;
    border: none;
    outline: none;
}

QListWidget#instances::item {
    background: #ffffff;
    color: #41474b;
    padding: 8px;
}

QListWidget#instances::item:selected {
    background: #ffe8ad;
    color: #2c627d;
    border: 1px solid #ffb703;
}

QListWidget#instances::item:hover {
    background: #ffe8ad;
    border-color: #ffb703;
}

QListWidget#navigation {
    background: #f8f9f9;
    border: 1px solid #d8dcde;
    border-radius: 4px;
    outline: none;
    padding: 6px;
}

QListWidget#navigation::item {
    color: #555c61;
    padding: 10px 12px;
    border-radius: 3px;
    margin-bottom: 2px;
}

QListWidget#navigation::item:selected {
    background: #4b9dcc;
    color: #ffffff;
}

QListWidget#navigation::item:hover {
    background: #e8f2f6;
    color: #2c627d;
}

QListWidget#navigation::item:focus {
    border: 1px solid #4b9dcc;
}

QStackedWidget#detailPages {
    background: #ffffff;
    border: 1px solid #d8dcde;
    border-radius: 4px;
}

QPlainTextEdit {
    background: #ffffff;
    color: #485057;
    border: 1px solid #d0d5d8;
    border-radius: 4px;
    padding: 10px;
    font-family: monospace;
}

QStatusBar {
    background: #e7e9ea;
    color: #687177;
    border-top: 1px solid #d0d4d6;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

QScrollBar:vertical {
    background: #eef0f1;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #b7bec2;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #9da7ad;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: none;
}

/* Nexus browser follows the instance window's flat surfaces and blue actions. */
QWidget#modBrowser { background: #f1f2f3; }
QListWidget#modList {
    background: #ffffff;
    border: 1px solid #d8dcde;
    border-radius: 4px;
    padding: 4px;
    outline: none;
}
QListWidget#modList::item {
    color: #41474b;
    padding: 10px 12px;
    border: 1px solid transparent;
    border-radius: 3px;
}
QListWidget#modList::item:hover { background: #fff4d6; }
QListWidget#modList::item:selected {
    background: #ffe8ad;
    color: #2c627d;
    border-color: #ffb703;
}
QListWidget#modList::item:focus { border-color: #805900; }
QWidget#modDetailPanel {
    background: #ffffff;
    border: 1px solid #d8dcde;
    border-radius: 4px;
}
QScrollArea#modDetailScroll, QWidget#modDetailContent {
    background: #ffffff;
    border: none;
}
QLabel#modTitle { color: #30363b; font-size: 20px; font-weight: 600; }
QLabel#modAuthor { color: #555c61; font-size: 13px; }
QLabel#modMetadata { color: #626c73; font-size: 12px; }
QLabel#modSummary { color: #41474b; font-size: 14px; }
QLabel#modDescription { color: #555c61; font-size: 13px; }
QLabel#modListStatus, QLabel#modDetailStatus { color: #626c73; font-size: 12px; }
QPushButton#modRefresh, QPushButton#backFromNexus {
    padding: 8px 12px;
    border: 1px solid transparent;
    border-radius: 4px;
}
QPushButton#modRefresh:hover, QPushButton#backFromNexus:hover { border-color: #aab3b8; }
QPushButton#modRefresh:focus, QPushButton#backFromNexus:focus { border-color: #805900; }
QPushButton#modDownload {
    background: #4b9dcc;
    color: #182f3d;
    border: 1px solid #4b9dcc;
    border-radius: 4px;
    padding: 10px 12px;
    font-weight: 600;
}
QPushButton#modDownload:hover { background: #63add6; border-color: #3d8ebd; }
QPushButton#modDownload:pressed { background: #ffb703; border-color: #ffb703; }
QPushButton#modDownload:focus { border-color: #24343d; }
QPushButton#modDownload:disabled { background: #e8eaeb; color: #747b80; border-color: #d7dbdd; }
QSplitter#modSplitter::handle { background: #f1f2f3; }
QSplitter#modSplitter::handle:hover { background: #d8dcde; }

QLabel#modPageCount { color: #626c73; font-size: 12px; }
QPushButton#modPrevious, QPushButton#modNext {
    padding: 6px 8px;
    border: 1px solid #cbd0d3;
    border-radius: 4px;
    background: #ffffff;
}
QPushButton#modPrevious:hover, QPushButton#modNext:hover { background: #e8f2f6; border-color: #4b9dcc; }
QPushButton#modPrevious:focus, QPushButton#modNext:focus { border-color: #805900; }
QPushButton#modPrevious:disabled, QPushButton#modNext:disabled {
    background: #e8eaeb; color: #747b80; border-color: #d7dbdd;
}
