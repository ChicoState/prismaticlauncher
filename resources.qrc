    <qresource prefix="/resources">
        <file alias="SMAPI_mascot.png">resources/SMAPI_mascot.png</file>
        <file alias="settings.png">resources/cogwheel.png</file>
        <file alias="logo.png">resources/logo.png</file>
    </qresource>
    <qresource prefix="/farmpack">
        <file alias="manifest.json">chickens/manifest.json</file>
        <file alias="default.png">chickens/default.png</file>
        <file alias="spring.png">chickens/spring.png</file>
        <file alias="summer.png">chickens/summer.png</file>
    </qresource>
</RCC>
